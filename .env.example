# Runtime profile: development | test | staging | production
SMART_DATA_AGENT_ENV=development
SMART_DATA_AGENT_AUTH_MODE=development
SMART_DATA_AGENT_AUTH_SECRET=
SMART_DATA_AGENT_AUTH_KEY_ID=local-v1
SMART_DATA_AGENT_AUTH_ISSUER=smart-data-agent
SMART_DATA_AGENT_AUTH_AUDIENCE=smart-data-agent-api
SMART_DATA_AGENT_SESSION_TTL_SECONDS=1800
SMART_DATA_AGENT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Application database. Production requires PostgreSQL; the local CLI accepts --db for SQLite.
SMART_DATA_AGENT_DATABASE_URL=

# Analytical warehouse: json (local mock), sqlite, postgresql, doris, hive, or csv_object.
SMART_DATA_AGENT_DATA_WAREHOUSE=json
SMART_DATA_AGENT_JSON_WAREHOUSE_PATH=
SMART_DATA_AGENT_SQLITE_WAREHOUSE_PATH=
SMART_DATA_AGENT_SQL_WAREHOUSE_CATALOG=configs/data_sources/sqlite_warehouse.example.json
SMART_DATA_AGENT_WAREHOUSE_DATABASE_URL=
SMART_DATA_AGENT_WAREHOUSE_POOL_MIN=1
SMART_DATA_AGENT_WAREHOUSE_POOL_MAX=10
SMART_DATA_AGENT_WAREHOUSE_STATEMENT_TIMEOUT_MS=30000
SMART_DATA_AGENT_WAREHOUSE_CONNECT_TIMEOUT_SECONDS=10
SMART_DATA_AGENT_DORIS_DATABASE_URL=
SMART_DATA_AGENT_DORIS_TLS=true
SMART_DATA_AGENT_DORIS_SSL_CA=
SMART_DATA_AGENT_HIVE_DATABASE_URL=
SMART_DATA_AGENT_CSV_MAX_OBJECT_BYTES=52428800
# Read-only CSV directory populated by an independent collection or file-delivery service.
SMART_DATA_AGENT_CSV_SOURCE_ROOT=Origin_Data
SMART_DATA_AGENT_CSV_MAX_FILE_BYTES=134217728
SMART_DATA_AGENT_MODEL_TIMEOUT_SECONDS=30
SMART_DATA_AGENT_EMBEDDED_WORKER=false
SMART_DATA_AGENT_WORKER_ID=automation-worker

# Optional remote semantic service. Fallback stays disabled unless explicitly enabled.
SMART_DATA_AGENT_SUPERSONIC_URL=
SMART_DATA_AGENT_SUPERSONIC_API_KEY=
SMART_DATA_AGENT_SUPERSONIC_TIMEOUT=8
SMART_DATA_AGENT_SUPERSONIC_RETRIES=1
SMART_DATA_AGENT_SUPERSONIC_FALLBACK_MODE=disabled

# OIDC enterprise identity (required in production strict mode).
SMART_DATA_AGENT_OIDC_ISSUER=
SMART_DATA_AGENT_OIDC_CLIENT_ID=
SMART_DATA_AGENT_OIDC_CLIENT_SECRET=
SMART_DATA_AGENT_OIDC_AUTHORIZATION_ENDPOINT=
SMART_DATA_AGENT_OIDC_TOKEN_ENDPOINT=
SMART_DATA_AGENT_OIDC_JWKS_URI=
SMART_DATA_AGENT_OIDC_REDIRECT_URI=
SMART_DATA_AGENT_OIDC_REQUIRE_VERIFIED_EMAIL=true
SMART_DATA_AGENT_POST_LOGIN_URL=/

# Distributed limits, outbound allowlist, malware scanning and envelope encryption.
SMART_DATA_AGENT_REDIS_URL=
SMART_DATA_AGENT_EGRESS_ALLOWED_HOSTS=
SMART_DATA_AGENT_EGRESS_PRIVATE_HOSTS=
SMART_DATA_AGENT_CLAMAV_HOST=
SMART_DATA_AGENT_CLAMAV_PORT=3310
SMART_DATA_AGENT_OCR_ENDPOINT=
SMART_DATA_AGENT_OCR_API_KEY=
SMART_DATA_AGENT_OCR_TIMEOUT_SECONDS=45
SMART_DATA_AGENT_SECRET_PROVIDER=local
SMART_DATA_AGENT_SECRET_KEY=
SMART_DATA_AGENT_KMS_COMMAND=

# Immutable artifacts. Production requires s3/oss/s3_compatible.
SMART_DATA_AGENT_OBJECT_STORE=local
SMART_DATA_AGENT_OBJECT_ROOT=
SMART_DATA_AGENT_OBJECT_BUCKET=
SMART_DATA_AGENT_OBJECT_REGION=
SMART_DATA_AGENT_OBJECT_ENDPOINT=
SMART_DATA_AGENT_OBJECT_PREFIX=smart-data-agent
SMART_DATA_AGENT_OBJECT_KMS_KEY_ID=
SMART_DATA_AGENT_STATIC_ROOT=dist

# Email delivery adapter.
SMART_DATA_AGENT_SMTP_HOST=
SMART_DATA_AGENT_SMTP_PORT=465
SMART_DATA_AGENT_SMTP_USERNAME=
SMART_DATA_AGENT_SMTP_PASSWORD=
SMART_DATA_AGENT_SMTP_FROM=
SMART_DATA_AGENT_PROVIDER_CALLBACK_SECRET=

# Browser client uses HttpOnly cookie sessions. The compatibility header switch is local-only.
VITE_ANALYSIS_API_URL=
VITE_SMART_DATA_AGENT_AUTH_TOKEN=
VITE_SMART_DATA_AGENT_ENABLE_DEV_IDENTITY_HEADERS=false

# Aliyun Fun-ASR speech integration.
FUN_ASR_WORKSPACE_ID=
FUN_ASR_REGION=cn-beijing
DASHSCOPE_API_BASE=
DASHSCOPE_API_KEY=

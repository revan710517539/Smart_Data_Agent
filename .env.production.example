# Production deployment contract for docker-compose.server.yml.
# Copy this file to a protected .env.production outside source control.
# Replace every required value through the deployment platform; never commit secrets.

# Immutable application image. Use a tag bound to one reviewed 40-character Git SHA.
SMART_DATA_AGENT_IMAGE=
SMART_DATA_AGENT_PUBLIC_ORIGIN=https://sda.example.com

# MySQL 8.0.18 with TLS verification. Credentials are secret values.
SMART_DATA_AGENT_DATABASE_URL=
SMART_DATA_AGENT_DB_POOL_MIN=2
SMART_DATA_AGENT_DB_POOL_MAX=20
SMART_DATA_AGENT_MYSQL_CA_HOST_PATH=/var/lib/mysql80/ca.pem

# Enterprise OIDC strict authentication.
SMART_DATA_AGENT_AUTH_SECRET=
SMART_DATA_AGENT_OIDC_ISSUER=https://id.example.com
SMART_DATA_AGENT_OIDC_CLIENT_ID=
SMART_DATA_AGENT_OIDC_CLIENT_SECRET=
SMART_DATA_AGENT_OIDC_AUTHORIZATION_ENDPOINT=https://id.example.com/authorize
SMART_DATA_AGENT_OIDC_TOKEN_ENDPOINT=https://id.example.com/token
SMART_DATA_AGENT_OIDC_JWKS_URI=https://id.example.com/.well-known/jwks.json
SMART_DATA_AGENT_OIDC_REDIRECT_URI=https://sda.example.com/api/auth/oidc/callback

# Redis must use TLS in production.
SMART_DATA_AGENT_REDIS_URL=rediss://redis.example.com:6380/0

# Immutable artifact storage and envelope encryption.
SMART_DATA_AGENT_OBJECT_BUCKET=
SMART_DATA_AGENT_OBJECT_REGION=
SMART_DATA_AGENT_OBJECT_ENDPOINT=
SMART_DATA_AGENT_OBJECT_PREFIX=smart-data-agent
SMART_DATA_AGENT_OBJECT_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Audited KMS provider executable mounted read-only by Compose.
SMART_DATA_AGENT_KMS_PROVIDER_HOST_PATH=
SMART_DATA_AGENT_KMS_COMMAND=/run/secrets/sda-kms-provider

# Governed read-only Data Crawler delivery and generated state.
SMART_DATA_AGENT_DATA_CRAWLER_HOST_ROOT=/opt/palywright/examples/data-crawler/data
# Exact SDA tenant -> Data Crawler institution/API/CSV-directory bindings.
# Store real per-institution tokens only in protected deployment configuration.
SMART_DATA_AGENT_DATA_CRAWLER_ENDPOINTS={}
SMART_DATA_AGENT_WORKER_ID=automation-worker-1

# Explicit outbound allowlist and malware-scanning service.
SMART_DATA_AGENT_EGRESS_ALLOWED_HOSTS=
SMART_DATA_AGENT_EGRESS_PRIVATE_HOSTS=
SMART_DATA_AGENT_EGRESS_DIRECT_HOSTS=
SMART_DATA_AGENT_CLAMAV_HOST=
SMART_DATA_AGENT_CLAMAV_PORT=3310

# API listener. Keep loopback binding behind the approved reverse proxy.
SMART_DATA_AGENT_HTTP_BIND=127.0.0.1
SMART_DATA_AGENT_HTTP_PORT=8787

# Optional external model adapter. Leave unset when not provisioned.
SMART_DATA_AGENT_DEFAULT_MODEL_API_BASE=
SMART_DATA_AGENT_DEFAULT_MODEL_API_KEY=
